# Copy to .env.local and fill in. Never commit .env.local.

# Public
NEXT_PUBLIC_SITE_URL=https://gethazledger.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
# LLM used by the SDS scanner to extract the 16 GHS sections
ANTHROPIC_API_KEY=

# Stripe billing (server only). Billing is disabled while STRIPE_SECRET_KEY is empty.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Set to true once tax registrations exist in Stripe Tax
STRIPE_AUTOMATIC_TAX=false
